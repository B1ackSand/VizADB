<Window x:Class="VizADB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VizADB.Converters"
        Title="VizADB - ADB &amp; scrcpy 设备管理"
        Icon="Assets/VizADB.ico"
        Width="700" Height="640"
        MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisible" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#C8C8C8" />
            <Setter Property="Foreground" Value="#222" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8A9098" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="VizADB" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="  ADB &amp; scrcpy 设备管理" FontSize="14" Foreground="#666"
                           VerticalAlignment="Center" Margin="10,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="设置" Padding="14,4" Click="OpenSettings_Click" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="连接设置" Style="{StaticResource HeaderText}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="IP 地址" Grid.Column="0" Style="{StaticResource LabelText}" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="IpBox" Style="{StaticResource InputBox}"
                                 Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock IsHitTestVisible="False"
                                   Text="例如 192.168.1.100"
                                   Foreground="#AAAAAA" Margin="8,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Text, ElementName=IpBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>

                    <TextBlock Text="端口" Grid.Column="3" Style="{StaticResource LabelText}" />

                    <Grid Grid.Column="4">
                        <TextBox x:Name="PortBox" Style="{StaticResource InputBox}"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock IsHitTestVisible="False"
                                   Text="默认 5555"
                                   Foreground="#AAAAAA" Margin="8,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Text, ElementName=PortBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="设备地址" Grid.Column="0" Style="{StaticResource LabelText}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#666"
                               Text="工具路径请点击右上角「设置」进行配置。" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="连接 ADB" Command="{Binding ConnectCommand}"
                            Background="#2E7D32" Foreground="White" />
                    <Button Content="断开连接" Command="{Binding DisconnectCommand}" />
                    <Button Content="重启设备" Command="{Binding RebootCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="连接状态" Style="{StaticResource HeaderText}" />

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="设备列表：" Margin="0,10,0,4" Foreground="#555" />
                <ListView ItemsSource="{Binding Devices}" Height="96"
                          BorderBrush="#E0E0E0" BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="序列号" Width="300"
                                            DisplayMemberBinding="{Binding Serial}" />
                            <GridViewColumn Header="状态" Width="180"
                                            DisplayMemberBinding="{Binding State}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="画面显示（scrcpy）" Style="{StaticResource HeaderText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="启动画面（含音频）" Command="{Binding ShowScreenCommand}"
                            Background="#1565C0" Foreground="White" />
                    <Button Content="启动画面（禁用音频）" Command="{Binding ShowScreenMutedCommand}" />
                    <TextBlock Text="需先连接设备" Foreground="#999" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="4" Header="日志" Padding="4">
            <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Padding="6" />
        </GroupBox>
    </Grid>
</Window>
