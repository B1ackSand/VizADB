<Window x:Class="VizADB.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="540" Height="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F4F6">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="工具路径配置" FontSize="14" FontWeight="SemiBold"
                   Foreground="#222" Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="ADB 路径" Grid.Column="0" VerticalAlignment="Center" Foreground="#444" />
            <TextBox x:Name="AdbBox" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center" />
            <Button Grid.Column="3" Content="浏览..." Click="BrowseAdb_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="scrcpy" Grid.Column="0" VerticalAlignment="Center" Foreground="#444" />
            <TextBox x:Name="ScrcpyBox" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center" />
            <Button Grid.Column="3" Content="浏览..." Click="BrowseScrcpy_Click" />
        </Grid>

        <TextBlock Grid.Row="3" Text="留空则自动查找（程序所在目录 / PATH / Android SDK）。"
                   Foreground="#888" VerticalAlignment="Top" Margin="0,2,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="80" Padding="0" Click="Save_Click" IsDefault="True"
                    Background="#2E7D32" Foreground="White" />
            <Button Content="取消" Width="80" Padding="0" Click="Cancel_Click" IsCancel="True"
                    Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
